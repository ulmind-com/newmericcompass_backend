# ---- MongoDB ----
MONGODB_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
DATABASE_NAME="newmericcompass"

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- First admin (used by scripts/create_admin.py when run without args) ----
ADMIN_EMAIL="admin@newmericcompass.com"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Administrator"

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Razorpay (payments) ----
# Never commit real values; set these in the Render environment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Where the API is reachable from a phone; used to build the checkout URL.
PUBLIC_BASE_URL="https://newmericcompass-backend.onrender.com"

# ---- Acharya contact shown on the treatment tab ----
ACHARYA_NAME="N5 Acharya"
ACHARYA_PHONE=""
ACHARYA_WHATSAPP=""

# ---- Transactional email (Resend) ----
RESEND_API_KEY=""
# Verified sender, e.g. contact@newmericcompass.in
MAIL_ADDRESS=""
# Optional: CDN copy of the logo shown in emails.
# Defaults to {PUBLIC_BASE_URL}/static/email/logo.png, which this API serves.
EMAIL_LOGO_URL=""
